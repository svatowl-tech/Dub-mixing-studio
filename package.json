    "@vitejs/plugin-react": "^4.3.4",
    "ass-compiler": "^0.1.16",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "epubjs": "^0.3.93",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
