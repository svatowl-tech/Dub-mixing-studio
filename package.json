    "@tauri-apps/cli-darwin-x64": "^2.2.0",
    "@tauri-apps/cli-linux-x64-gnu": "^2.2.0",
    "@tauri-apps/cli-win32-x64-msvc": "^2.2.0",
    "lightningcss-darwin-arm64": "1.32.0",
    "lightningcss-darwin-x64": "1.32.0",
    "lightningcss-linux-x64-gnu": "1.32.0",
