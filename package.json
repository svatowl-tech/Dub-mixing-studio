  "version": "1.2.0",
  "description": "Dub Mixing Studio - Professional Audio Mixing, Dubbing and Source Separation Software (Tauri v2)",
  "author": "Dub Mixing Studio Team",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
