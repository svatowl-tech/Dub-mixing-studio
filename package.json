    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.18.1",
    "extract-zip": "^2.0.1",
    "ffmpeg-static": "^5.3.0",
